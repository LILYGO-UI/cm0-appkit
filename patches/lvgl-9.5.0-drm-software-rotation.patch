+static void drm_rotation_event_cb(lv_event_t * event)
+{
+    lv_display_t * disp = lv_event_get_current_target(event);
+    drm_dev_t * drm_dev = lv_event_get_user_data(event);
+
+    if(lv_display_get_rotation(disp) == LV_DISPLAY_ROTATION_0) {
