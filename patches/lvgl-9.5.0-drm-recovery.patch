--- a/src/drivers/display/drm/lv_linux_drm.c
+++ b/src/drivers/display/drm/lv_linux_drm.c
@@ -64,6 +64,7 @@
     uint32_t fourcc;
     drmModeModeInfo mode;
     uint32_t blob_id;
+    bool needs_modeset;
     drmModeCrtc * saved_crtc;
     drmModeAtomicReq * req;
     drmEventContext drm_event_ctx;
@@ -443,7 +444,6 @@
 static int drm_dmabuf_set_plane(drm_dev_t * drm_dev, drm_buffer_t * buf)
 {
     int ret;
-    static int first = 1;
     uint32_t flags = DRM_MODE_PAGE_FLIP_EVENT | DRM_MODE_ATOMIC_NONBLOCK;
 
 #if LV_USE_LINUX_DRM_GBM_BUFFERS
@@ -460,7 +460,7 @@
     drm_dev->req = drmModeAtomicAlloc();
 
     /* On first Atomic commit, do a modeset */
-    if(first) {
+    if(drm_dev->needs_modeset) {
         drm_add_conn_property(drm_dev, "CRTC_ID", drm_dev->crtc_id);
 
         drm_add_crtc_property(drm_dev, "MODE_ID", drm_dev->blob_id);
@@ -468,7 +468,6 @@
 
         flags |= DRM_MODE_ATOMIC_ALLOW_MODESET;
 
-        first = 0;
     }
 
     drm_add_plane_property(drm_dev, "FB_ID", buf->fb_handle);
@@ -486,9 +485,12 @@
     if(ret) {
         LV_LOG_ERROR("drmModeAtomicCommit failed: %s (%d)", strerror(errno), errno);
         drmModeAtomicFree(drm_dev->req);
+        drm_dev->req = NULL;
         return ret;
     }
 
+    drm_dev->needs_modeset = false;
+
     return 0;
 }
 
@@ -744,6 +746,23 @@
         goto err;
     }
 
+    /* Opening a primary node while another boot client owns DRM master does
+     * not automatically promote this file after that client exits. Wait and
+     * explicitly acquire master so the first atomic modeset cannot fail
+     * silently and leave the display black. */
+    for(int attempt = 0; attempt < 100; ++attempt) {
+        ret = drmSetMaster(fd);
+        if(ret == 0)
+            break;
+        if(errno != EBUSY && errno != EACCES && errno != EPERM)
+            break;
+        usleep(100000);
+    }
+    if(ret < 0) {
+        LV_LOG_ERROR("drmSetMaster failed: %s", strerror(errno));
+        goto err;
+    }
+
     return fd;
 err:
     close(fd);
@@ -815,6 +834,7 @@
