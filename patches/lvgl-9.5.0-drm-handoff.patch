+lv_result_t lv_linux_drm_suspend(lv_display_t * disp)
+{
+    if(!disp) return LV_RESULT_INVALID;
+    lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
+    if(!ctx || ctx->fd < 0 || !ctx->egl_ctx || !ctx->gbm_surface ||
+       !ctx->drm_crtc || !ctx->drm_connector || !ctx->drm_encoder || !ctx->drm_mode ||
+       !ctx->crtc_isset || !ctx->gbm_bo_presented || ctx->suspended) return LV_RESULT_INVALID;
+
+    /* Complete the outstanding flip before changing master. Its event owns
+     * the transition from the previous front buffer to the retained one. */
+    uint32_t started = tick_cb();
+    while(ctx->gbm_bo_flipped) {
+        uint32_t elapsed = tick_cb() - started;
+        if(elapsed >= 1000 || drm_do_page_flip(ctx, (int)(1000 - elapsed)) <= 0) {
+            LV_LOG_ERROR("Failed to finish DRM page flip before handoff");
+            return LV_RESULT_INVALID;
+        }
+    }
+    if(ctx->gbm_bo_pending) {
+        gbm_surface_release_buffer(ctx->gbm_surface, ctx->gbm_bo_pending);
+        ctx->gbm_bo_pending = NULL;
+    }
+    if(drmDropMaster(ctx->fd) < 0) {
+        LV_LOG_ERROR("Failed to release DRM master: %s", strerror(errno));
+        return LV_RESULT_INVALID;
+    }
+    /* Keep the presented BO locked: the next client may save its FB as the
+     * CRTC to restore on exit. EGL and the original saved CRTC stay intact. */
+    ctx->suspended = true;
+    /* Suppress final CRTC restoration while another client owns master. */
+    ctx->crtc_isset = false;
+    return LV_RESULT_OK;
+}
+
+lv_result_t lv_linux_drm_resume(lv_display_t * disp)
+{
+    if(!disp) return LV_RESULT_INVALID;
+    lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
+    if(!ctx || ctx->fd < 0 || !ctx->egl_ctx || !ctx->gbm_surface ||
+       !ctx->drm_crtc || !ctx->drm_connector || !ctx->drm_encoder || !ctx->drm_mode ||
+       ctx->crtc_isset || !ctx->gbm_bo_presented || !ctx->suspended ||
+       ctx->gbm_bo_flipped || ctx->gbm_bo_pending) return LV_RESULT_INVALID;
+
+    drm_fb_state_t * fb = gbm_bo_get_user_data(ctx->gbm_bo_presented);
+    if(!fb || !fb->fb_id || fb->fd != ctx->fd || fb->bo != ctx->gbm_bo_presented)
+        return LV_RESULT_INVALID;
+
+    int status = -1;
+    for(int attempt = 0; attempt < 100; ++attempt) {
+        status = drmSetMaster(ctx->fd);
+        if(status == 0 || (errno != EBUSY && errno != EACCES && errno != EPERM)) break;
+        if(attempt < 99) usleep(10000);
+    }
+    if(status < 0) {
+        LV_LOG_ERROR("Failed to reacquire DRM master: %s", strerror(errno));
+        return LV_RESULT_INVALID;
+    }
+    /* Another client may have changed the mode or CRTC. Bind our retained
+     * frame before allowing any new rendering or input processing. */
+    status = drmModeSetCrtc(ctx->fd, ctx->drm_encoder->crtc_id, fb->fb_id, 0, 0,
+                          &ctx->drm_connector->connector_id, 1, ctx->drm_mode);
+    if(status < 0) {
+        LV_LOG_ERROR("Failed to restore DRM scanout after handoff: %s", strerror(errno));
+        if(drmDropMaster(ctx->fd) < 0)
+            LV_LOG_ERROR("Failed to release DRM master after resume failure: %s", strerror(errno));
+        return LV_RESULT_INVALID;
+    }
+    ctx->suspended = false;
+    ctx->crtc_isset = true;
     return LV_RESULT_OK;
 }
 
