+void lv_nanovg_flush_pending(struct _lv_draw_nanovg_unit_t * u)
+{
+    LV_ASSERT_NULL(u);
+    bool is_started = u->is_started;
+    lv_nanovg_end_frame(u);
+    /* More commands will be queued by the same task. nvgBeginFrame would reset
+     * its transform and scissor, so preserve the existing frame instead. */
+    u->is_started = is_started;
